# Allowlist: ship only what a uv-type bundle needs to run (per the MCPB spec:
# manifest, pyproject.toml, source). Everything else in the repo stays out.
# No trailing slashes: mcpb tests folder paths without one, so "src/" would never match.
/*
!/manifest.json
!/pyproject.toml
!/uv.lock
!/src
!/assets
# pyproject.toml names these as readme/license; the host's uv build fails without them.
!/README.md
!/LICENSE.md

# Inside the allowed folders
__pycache__
*.pyc
*.egg-info
*.mov
